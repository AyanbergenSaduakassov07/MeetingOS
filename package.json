{
  "name": "meetingos",
  "version": "0.2.0",
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/node": "^20.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.8",
  "private": true,
  "scripts": {
    "dev:web": "cd web && bun run dev",
    "dev:server": ".venv/bin/python -m uvicorn backend.main:app --reload --port 8470",
    "build:web": "cd web && bun run build",
    "lint": "biome lint web/src",
    "typecheck": "cd web && bunx tsc --noEmit",
    "format": "biome format --write web/src backend/tests/eval_cases",
    "check": "biome check web/src backend/tests/eval_cases",
    "check:fix": "biome check --write web/src backend/tests/eval_cases",
    "ci": "bun run typecheck && bun run build:web"
  },
  "workspaces": [
    "web"
  ]
}
