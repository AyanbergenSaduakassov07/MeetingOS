# MeetingOS configuration. Copy to .env (`just setup` does this) and fill in.
# Only one AI provider and one transcription provider need keys.

# --- Access -----------------------------------------------------------------
# Required for any bind other than 127.0.0.1 (min 16 chars). `just gen-key`.
# Agents send it as `Authorization: Bearer <key>`; the browser logs in with it.
MEETINGOS_API_KEY=

# --- Language model -----------------------------------------------------------
# anthropic | openai | openai_compatible
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI, or any OpenAI-wire service (OpenRouter: set OPENAI_BASE_URL).
# OpenAI is also the default embeddings provider.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=
# OPENAI_EMBEDDING_MODEL=

# Self-hosted model (Ollama, vLLM, LM Studio): nothing leaves your network.
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_EMBEDDING_MODEL=
# OPENAI_COMPATIBLE_API_KEY=

# --- Transcription ------------------------------------------------------------
# whisper_cloud (uses OPENAI_API_KEY) | assemblyai | pyannote_local
# faster_whisper: runs locally, audio never leaves the machine (uv pip install faster-whisper)
# FASTER_WHISPER_MODEL=small
TRANSCRIPTION_PROVIDER=whisper_cloud
# ASSEMBLYAI_API_KEY=
# HUGGINGFACE_TOKEN=          # pyannote_local diarization

# --- Privacy ------------------------------------------------------------------
# Redact emails, phones and IDs before transcripts reach a cloud model.
MEETINGOS_REDACT_TRANSCRIPTS=0
# Extra inference hosts to allow, comma-separated (defaults cover the providers above).
# MEETINGOS_ALLOWED_INFERENCE_HOSTS=
# Pin this process to one organization.
# MEETINGOS_ORG_ID=

# --- Server -------------------------------------------------------------------
# MEETINGOS_CORS_ORIGINS=http://localhost:5173
# MEETINGOS_MAX_UPLOAD_BYTES=262144000
# MEETINGOS_UPLOAD_PER_MINUTE=
# MEETINGOS_ASK_PER_MINUTE=
# MEETINGOS_MAX_CONCURRENT_PROCESSING=
